# ===================================================
# HONEYMETRICS V2 UNIVERSIDAD - ENVIRONMENT TEMPLATE
# (Sincronizado con el proyecto guía honeymetrics-backend el 02/11/2026)
# ⚠️ Este archivo JAMÁS debe contener secretos reales. Cópialo a .env y
#    llena los valores desde el .env del proyecto guía (fuente única).
# Permisos recomendados: chmod 644 .env  (usuario 1001 appuser en Docker)
# ===================================================

# 1. INFORMACIÓN DEL PROYECTO Y ENTORNO
PROJECT_NAME="HoneyMetrics v2 API (UDEC)"
VERSION="2.0.0-academic"
ENVIRONMENT="development"
DEBUG=True

# 2. RUTAS API Y SEGURIDAD CORS
API_V1_STR="/api/v1"
# Desarrollo local por defecto; en producción apuntar al Workers de Cloudflare:
FRONTEND_URL="http://localhost:5173"
BACKEND_CORS_ORIGINS=["http://localhost:5173","http://localhost:5174","http://localhost:3000","http://127.0.0.1:5173","https://honeymetrics-v2-frontend.johan-sebastianposada.workers.dev"]

# 3. BASE DE DATOS (PostgreSQL 16 Alpine en Docker, puerto host 5433)
# 🔒 PoLP en producción: usuario enjaulado (NUNCA 'postgres', 'sa' o 'root'):
POSTGRES_USER="postgres"
POSTGRES_PASSWORD="cambia_esta_password"
POSTGRES_DB="honeymetrics_v2"
DATABASE_URL="postgresql+psycopg2://postgres:cambia_esta_password@db:5432/honeymetrics_v2"

# 4. SEGURIDAD, TOKENS JWT Y AUTENTICACIÓN
# SECRET_KEY: generar con `openssl rand -base64 48`. Vacío en dev genera una efímera.
SECRET_KEY=""
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=480
REQUIRE_PASSWORD_CHANGE_ON_FIRST_LOGIN=False
MFA_ENABLED=True

# 5. GOBERNANZA DE CORREO INSTITUCIONAL
# allowlist = solo dominios de ALLOWED_EMAIL_DOMAINS; "any" = sin restricción
EMAIL_DOMAIN_POLICY="allowlist"
ALLOWED_EMAIL_DOMAINS="ucundinamarca.edu.co,gmail.com"

# 6. CLOUDFLARE ZERO TRUST TUNNEL (Opcional para desarrollo)
CLOUDFLARE_TUNNEL_TOKEN=""

# 7. INTEGRACIÓN TELEGRAM BOT (Human-in-the-Loop para Aprobaciones de Logs Masivos)
# Credenciales reales viven en .env (fuente: proyecto guía)
TELEGRAM_BOT_TOKEN="tu_token_de_botfather"
ADMIN_TELEGRAM_CHAT_ID="tu_chat_id"
TELEGRAM_WEBHOOK_SECRET="un_secreto_aleatorio_largo"

# 8. WAZUH INDEXER (OpenSearch SIEM Clúster)
WAZUH_INDEXER_URL="https://192.168.32.11:9200"
WAZUH_INDEXER_USER="admin"
WAZUH_INDEXER_PASSWORD="tu_password_de_wazuh"
WAZUH_TLS_VERIFY=False
WAZUH_REQUEST_TIMEOUT_SECONDS=15

# 9. CORREO TRANSACCIONAL RESEND (dominio verificado johan-d3v.site)
RESEND_API_KEY=""
RESEND_FROM_EMAIL="HoneyMetrics Security <security@johan-d3v.site>"

# 10. DATASETS JSONL REALES (Wazuh) para descargas nunca vacías:
#     - Primero las rutas INTERNAS del contenedor (montadas :ro en docker-compose.yml).
#     - Luego las rutas del HOST (para ejecución fuera de Docker / pytest).
#     El streamer hereda, además, app/data/wazuh_sample_alerts.jsonl como
#     salvaguarda real (líneas reales de Wazuh empaquetas en la imagen).
DATASET_PATHS=["/app/datasets_wazuh/recent_months/logs_2026.08.jsonl","/app/datasets_wazuh/recent_months/logs_2026.07.jsonl","/app/datasets_wazuh/logs_17.jsonl"]
