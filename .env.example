# ===================================================
# HONEYMETRICS V2 UNIVERSIDAD - ENVIRONMENT TEMPLATE
# ===================================================

# 1. INFORMACIÓN DEL PROYECTO Y ENTORNO
PROJECT_NAME="HoneyMetrics v2 API (UDEC)"
VERSION="2.0.0-academic"
ENVIRONMENT="development"
DEBUG=True

# 2. RUTAS API Y SEGURIDAD CORS
API_V1_STR="/api/v1"
BACKEND_CORS_ORIGINS=["http://localhost:5173","http://localhost:3000","http://127.0.0.1:5173"]

# 3. BASE DE DATOS (PostgreSQL 16 Alpine en Docker)
# En desarrollo local se permite el superusuario base:
POSTGRES_USER="postgres"
POSTGRES_PASSWORD="postgres_password"
POSTGRES_DB="honeymetrics_v2"
DATABASE_URL="postgresql://postgres:postgres_password@db:5432/honeymetrics_v2"

# 🔒 REGLA DE SEGURIDAD PARA PRODUCCIÓN (Principio de Menor Privilegio - PoLP):
# En producción JAMÁS usar 'postgres', 'sa' o 'root'. Se debe crear un usuario enjaulado:
# Ejemplo:
# POSTGRES_USER="usr_honeymetrics"
# POSTGRES_PASSWORD="PasswordSegura_Produccion_2026#"
# DATABASE_URL="postgresql://usr_honeymetrics:PasswordSegura_Produccion_2026#@db:5432/honeymetrics_v2"

# 4. SEGURIDAD, TOKENS JWT Y AUTENTICACIÓN
SECRET_KEY="supersecretkey_change_in_production_generate_with_openssl"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=60
REQUIRE_PASSWORD_CHANGE_ON_FIRST_LOGIN=True

# 5. CLOUDFLARE ZERO TRUST TUNNEL (Opcional para desarrollo)
CLOUDFLARE_TUNNEL_TOKEN=""
