# ===================================================
# HONEYMETRICS V2 UNIVERSIDAD - ENVIRONMENT TEMPLATE
# ===================================================

# 1. INFORMACIÓN DEL PROYECTO Y ENTORNO
PROJECT_NAME="HoneyMetrics v2 API (UDEC)"
VERSION="2.0.0-academic"
ENVIRONMENT="development"
DEBUG=True

# 2. RUTAS API Y SEGURIDAD CORS
API_V1_STR="/api/v1"
BACKEND_CORS_ORIGINS=["http://localhost:5174","http://localhost:5173","http://localhost:3000","http://127.0.0.1:5174"]
FRONTEND_URL="http://localhost:5174"

# 3. BASE DE DATOS (PostgreSQL 16 Alpine en Docker)
# En desarrollo local se permite el superusuario base:
POSTGRES_USER="postgres"
POSTGRES_PASSWORD="postgres_password"
POSTGRES_DB="honeymetrics_v2"
DATABASE_URL="postgresql://postgres:postgres_password@db:5432/honeymetrics_v2"

# 🔒 REGLA DE SEGURIDAD PARA PRODUCCIÓN (Principio de Menor Privilegio - PoLP):
# En producción JAMÁS usar 'postgres', 'sa' o 'root'. Se debe crear un usuario enjaulado:
# Ejemplo:
# POSTGRES_USER="usr_honeymetrics"
# POSTGRES_PASSWORD="PasswordSegura_Produccion_2026#"
# DATABASE_URL="postgresql://usr_honeymetrics:PasswordSegura_Produccion_2026#@db:5432/honeymetrics_v2"

# 4. SEGURIDAD, TOKENS JWT Y AUTENTICACIÓN
SECRET_KEY=""
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=60
REQUIRE_PASSWORD_CHANGE_ON_FIRST_LOGIN=True

# 5. CLOUDFLARE ZERO TRUST TUNNEL (Opcional para desarrollo)
CLOUDFLARE_TUNNEL_TOKEN=""

# 6. INTEGRACIÓN TELEGRAM BOT (Human-in-the-Loop para Aprobaciones de Logs Masivos)
# Token obtenido desde @BotFather para HoneyMetrics v2:
TELEGRAM_BOT_TOKEN="tu_token_aqui"
# Chat ID numérico del administrador donde llegarán las alertas interactivas:
ADMIN_TELEGRAM_CHAT_ID="tu_chat_id_aqui"
# Secreto opcional para autenticar webhooks entrantes de Telegram:
TELEGRAM_WEBHOOK_SECRET=""

# 7. WAZUH INDEXER (OpenSearch SIEM Clúster)
WAZUH_INDEXER_URL=""
WAZUH_INDEXER_USER=""
WAZUH_INDEXER_PASSWORD="tu_password_de_wazuh"
WAZUH_TLS_VERIFY=True

# 8. CORREO TRANSACCIONAL RESEND - PB-HM-06.1 (Ente UDEC, mismo dominio guía)
# Guía usa security@johan-d3v.site; académico usa udec-auth@ para no interferir.
# Hereda SPF/DKIM/DMARC de johan-d3v.site. Sin key -> simulación con log.
RESEND_API_KEY=""
RESEND_FROM_EMAIL="HoneyMetrics UDEC <udec-auth@johan-d3v.site>"
